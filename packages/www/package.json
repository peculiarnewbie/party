{
    "name": "www",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "alchemy dev alchemy.run.ts",
        "dev:party": "node --import tsx scripts/dev-party.ts",
        "build": "vite build && tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "preview": "alchemy dev alchemy.run.ts --stage preview",
        "deploy": "alchemy deploy alchemy.run.ts --stage prod --profile party --yes --adopt",
        "destroy": "alchemy destroy alchemy.run.ts --stage prod --profile party",
        "test:unit": "vitest run",
        "test:fuzz": "vitest run src/game/poker/engine.fuzz.test.ts src/game/yahtzee/engine.fuzz.test.ts src/game/perudo/engine.fuzz.test.ts src/game/rps/engine.fuzz.test.ts",
        "test:worker": "vitest run --config vitest.worker.config.ts",
        "test:soak": "vitest run --config vitest.soak.config.ts",
        "test:infra": "vitest run --config vitest.infra.config.ts",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "node --import tsx scripts/run-e2e.ts",
        "test:browser:deps": "playwright install chromium",
        "test:all": "npm run test:unit && npm run test:worker && npm run test:soak && npm run test:e2e -- --browser all",
        "trace": "node --import tsx scripts/open-trace.ts",
        "report": "playwright show-report playwright-report"
    },
    "dependencies": {
        "@party/effect-utils": "workspace:*",
        "@solidjs/web": "2.0.0-rc.9",
        "@stylexjs/stylex": "0.19.1",
        "@tanstack/solid-router": "2.0.0-rc.8",
        "animejs": "^4.2.2",
        "effect": "4.0.0-beta.102",
        "luxon": "^3.7.2",
        "nanoid": "^5.1.6",
        "qrcode": "^1.5.4",
        "remeda": "^2.32.2",
        "solid-js": "2.0.0-rc.9"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.20.3",
        "@cloudflare/workers-types": "5.20260809.1",
        "@effect/platform-node": "4.0.0-beta.102",
        "@playwright/test": "^1.60.0",
        "@solidjs/testing-library": "1.0.0-beta.3",
        "@stylexjs/unplugin": "0.19.1",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/router-plugin": "1.168.40",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/luxon": "^3.7.1",
        "@types/node": "^22.5.4",
        "@types/qrcode": "^1.5.6",
        "alchemy": "2.0.0-beta.70",
        "fast-check": "^4.8.0",
        "happy-dom": "^20.9.0",
        "playwright": "^1.60.0",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "typescript": "^5.7.2",
        "unplugin": "^2.3.11",
        "vite": "^8.0.7",
        "vite-plugin-solid": "3.0.0-next.27",
        "vitest": "^4.1.4"
    }
}
