{
    "name": "quiz-manager",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "alchemy dev alchemy.run.ts",
        "build": "vite build && tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "preview": "alchemy dev alchemy.run.ts --stage preview",
        "deploy": "alchemy deploy alchemy.run.ts --stage prod --profile party --yes --adopt",
        "destroy": "alchemy destroy alchemy.run.ts --stage prod --profile party",
        "db:generate": "drizzle-kit generate",
        "seed:herd": "node --import tsx scripts/seed-herd.ts",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@party/effect-utils": "workspace:*",
        "@tanstack/solid-router": "^1.141.8",
        "@tanstack/solid-start": "^1.142.5",
        "drizzle-orm": "^0.38.0",
        "effect": "4.0.0-beta.102",
        "nanoid": "^5.1.6",
        "solid-js": "^1.9.10"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20260809.1",
        "@effect/platform-node": "4.0.0-beta.102",
        "@tailwindcss/vite": "^4.1.18",
        "drizzle-kit": "^0.31.0",
        "alchemy": "2.0.0-beta.70",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.7",
        "vite-plugin-solid": "^2.11.10",
        "vitest": "^4.1.4"
    }
}
