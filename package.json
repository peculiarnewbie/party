{
    "name": "party",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm --filter www build",
        "build:quiz-manager": "pnpm --filter quiz-manager build",
        "deploy": "pnpm --filter www run deploy",
        "destroy": "pnpm --filter www run destroy",
        "prepare": "effect-language-service patch",
        "typecheck": "pnpm --filter www run typecheck",
        "test:unit": "pnpm --filter www test:unit",
        "test:fuzz": "pnpm --filter www test:fuzz",
        "test:quiz-manager": "pnpm --filter quiz-manager test:unit",
        "test:worker": "pnpm --filter www test:worker",
        "test:soak": "pnpm --filter www test:soak",
        "test:infra": "pnpm --filter www test:infra",
        "test:e2e": "pnpm --filter www test:e2e",
        "test:all": "pnpm test:unit && pnpm test:quiz-manager && pnpm test:quiz-rpc && pnpm test:worker && pnpm test:soak && pnpm test:e2e -- --browser all",
        "trace": "pnpm --filter www trace",
        "report": "pnpm --filter www report",
        "test:quiz-rpc": "pnpm --filter quiz-manager test:worker"
    },
    "devDependencies": {
        "@effect/language-service": "^0.87.2",
        "@effect/platform-node": "4.0.0-beta.102",
        "alchemy": "2.0.0-beta.70",
        "effect-solutions": "^0.5.2",
        "prettier": "^3.7.4",
        "typescript": "^5.7.2"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "pnpm": {
        "overrides": {
            "@cloudflare/vitest-pool-workers>wrangler": "-"
        },
        "patchedDependencies": {
            "@cloudflare/vitest-pool-workers@0.20.3": "patches/@cloudflare__vitest-pool-workers@0.20.3.patch"
        }
    },
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "effect": "4.0.0-beta.102"
    }
}
